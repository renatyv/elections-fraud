<?xml version="1.0" encoding="UTF-8"?>
<!--
macOS LaunchAgent: runs the scraper every 15 minutes.
Install:
  cp "<this file>" ~/Library/LaunchAgents/com.user.serbia-rik-scraper.plist
  launchctl load ~/Library/LaunchAgents/com.user.serbia-rik-scraper.plist
Stop:
  launchctl unload ~/Library/LaunchAgents/com.user.serbia-rik-scraper.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.serbia-rik-scraper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/renatyuldashev/Documents/elections analysis/serbia-oct-2026/scripts/scrape_rik.py</string>
        <string>--levels</string>
        <string>national,regions</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/renatyuldashev/Documents/elections analysis/serbia-oct-2026/data/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/renatyuldashev/Documents/elections analysis/serbia-oct-2026/data/launchd.log</string>
</dict>
</plist>
